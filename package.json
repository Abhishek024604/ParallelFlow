{
  "name": "parallelflow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "dev:worker": "pnpm --filter @parallelflow/worker dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "pnpm --filter @parallelflow/db run migrate",
    "db:seed": "pnpm --filter @parallelflow/db run seed",
    "db:migrate:down": "pnpm --filter @parallelflow/db run migrate:down",
    "db:reset": "pnpm --filter @parallelflow/db run reset",
    "db:codegen": "pnpm --filter @parallelflow/db run codegen",
    "contract:lint": "redocly lint docs/contracts/openapi_v2.yaml"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "2.57.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/chord": "1.0.1",
      "@earendil-works/pi-ai": "1.0.1",
      "@earendil-works/pi-agent-core": "1.0.1",
      "@earendil-works/pi-mcp": "1.0.1",
      "@earendil-works/pi-tui": "1.0.1",
      "@earendil-works/pi-codemode": "1.0.1",
      "@earendil-works/pi-telemetry": "1.0.1"
    },
    "neverBuiltDependencies": [
      "@drawio/mcp"
    ]
  }
}
