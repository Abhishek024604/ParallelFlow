# Copy to .env.local. Variables from doc 11 §11.7. Local values match docker-compose.yml.

# Postgres (ADR-030). Neon: create the project on Postgres 16 and copy the URLs from the console.
# Owner role, DIRECT endpoint (no "-pooler"): migrations, codegen. Never used by the running app.
MIGRATION_DATABASE_URL=postgres://saras:saras@localhost:5432/saras
# App login role (member of saras_app, no BYPASSRLS). `pnpm db:migrate` creates it from this user and
# password. On Neon use the POOLED endpoint ("-pooler" in the host) and a long random password.
DATABASE_URL=postgres://saras_api:saras-api-local@localhost:5432/saras
# Outbox relay + pg-boss login (ADR-033): member of saras_relay, no BYPASSRLS. DIRECT endpoint (no
# "-pooler"), its own user (not the owner, not the app login), long random password. `pnpm db:migrate`
# creates it from this user and password.
RELAY_DATABASE_URL=postgres://saras_relay_login:saras-relay-local@localhost:5432/saras
# Optional: owner URL (direct) of a server where integration tests may create throwaway databases.
# Unset = Testcontainers (needs Docker). Never point this at a database you care about.
TEST_DATABASE_URL=

# API (apps/api). Rate limits default to doc 07 §7.1; change them only for load tests.
# PORT=4000
# LOG_LEVEL=info
# RATE_LIMIT_USER_PER_MINUTE=600
# RATE_LIMIT_ORG_PER_MINUTE=6000

# Worker (apps/worker): outbox relay polling, doc 05 §5.5.
# OUTBOX_POLL_MS=250
# OUTBOX_IDLE_MAX_MS=2000
# OUTBOX_BATCH_SIZE=100

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ARTIFACTS=saras-artifacts
S3_ACCESS_KEY_ID=saras
S3_SECRET_ACCESS_KEY=saras-minio

# Auth (WorkOS test environment)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
# Encrypts the session cookie, at least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
WORKOS_COOKIE_PASSWORD=
# Must be registered in WorkOS (Redirects, or POST /user_management/redirect_uris). It is on the web
# origin: the web app proxies /v1/* to the API, so the session cookies belong to the web origin.
# Sign-in is on when WORKOS_API_KEY, WORKOS_CLIENT_ID and WORKOS_COOKIE_PASSWORD are set (all four needed).
WORKOS_REDIRECT_URI=http://localhost:3000/v1/auth/callback
# The web app: the only post-login redirect target (ADR-032), and the CORS origin (a safety net:
# the browser reaches the API same-origin through the web app's /v1 proxy).
WEB_ORIGIN=http://localhost:3000
# `pnpm dev` = watchers + on-demand page compiling (coding). `pnpm demo` = one `next build` (into
# apps/web/.next-demo) + `next start`, API, App Tools and runtime without watchers (fast; README).
# Optional: API_READ_CACHE=off turns off the API's 30 s in-memory cache of GET responses.
# API_READ_CACHE=off
# Optional: domain of the readable parallelflow_csrf cookie when web and API are sibling hosts
# (app.example.com + api.example.com → example.com). Unset = host-only: leave it unset behind the
# web app's /v1 proxy.
# COOKIE_DOMAIN=

# Web (apps/web). Next.js reads this from apps/web/.env.local (not this file). Server-side only: the
# /v1 proxy target and what the Next server (middleware, server components) calls. Defaults to the
# local API, so `pnpm dev` does not need it. The proxy target is fixed at `next build`, so set it
# there too. The browser only ever calls the web origin.
# API_URL=http://localhost:4000

# Agent runtime (apps/runtime: RIC v0.2 over the Pi harness, ADR-035; needs Node >= 22.19). Unset
# RUNTIME_URL = AI is not connected: @AI in an arena fails fast and shows "AI isn't connected yet".
# The base URL includes /v1. `pnpm dev` starts the runtime on :7070.
RUNTIME_URL=http://localhost:7070/v1
RUNTIME_KIND=tau
# Signs the short-lived service JWT on every runtime call (HS256, aud=parallelflow-runtime). >= 32 chars;
# required when RUNTIME_URL is set. The API and the runtime read the same value. Generate with the
# command above.
RUNTIME_JWT_KEY=
# The model provider of the runtime (OpenRouter). Empty = sessions work, every AI turn fails fast with
# RUNTIME_UNAVAILABLE ("AI isn't connected yet"). Never commit a real key.
OPENROUTER_API_KEY=
# OpenRouter model id (<vendor>/<model>). Set = this one model for every request; unset = the
# parallelflow/auto router picks RUNTIME_MODEL_FAST or RUNTIME_MODEL_STRONG per request (apps/runtime/src/config.ts).
RUNTIME_MODEL=anthropic/claude-sonnet-4.5
# Models come from here only (no built-in defaults). Tried in order when a model is overloaded or
# rate-limited (comma-separated; unset or empty = no fallback).
# RUNTIME_FALLBACK_MODELS=
# Session files of the runtime, one folder per session (gitignored). Default: apps/runtime/.data
# RUNTIME_DATA_DIR=
# Connectors: external MCP servers the AI may use (comma-separated; empty = none). Default: drawio
# (draw.io diagrams). Each runs pinned from the lockfile, sandboxed (Node permission model, its own
# folder under RUNTIME_DATA_DIR, no inherited environment). See packages/pi-parallelflow/src/connectors.ts.
# RUNTIME_CONNECTORS=drawio

# App Tools MCP server (apps/app-tools, ADR-035). Handed to the runtime as ToolToken.mcp_url.
APP_TOOLS_URL=http://localhost:4200/mcp
# Signs session-scoped tool tokens (HS256, <= 60 min). >= 32 chars; required with RUNTIME_URL. The API
# (signs) and App Tools (verifies) read the same value.
TOOL_TOKEN_KEY=

# Evidence
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Email (Mailpit SMTP locally), analytics, errors, tracing
SES_SMTP_HOST=localhost
SES_SMTP_PORT=1025
POSTHOG_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Invites and email
# Invite emails (nodemailer). Unset = no emails; copy links from the arena's Members tab.
# Gmail: smtps://you%40gmail.com:<app password>@smtp.gmail.com:465 · Mailpit: smtp://localhost:1025
SMTP_URL=
MAIL_FROM=ParallelFlow <no-reply@example.com>
# Optional key for invite links (default: derived from WORKOS_COOKIE_PASSWORD). Changing it ends all links.
# INVITE_LINK_KEY=
