{
  "name": "@saras/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Migrations (schema_v2), Kysely types, tenant-context helper, outbox and relay accessor",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts migrate",
    "migrate:down": "tsx src/cli.ts down",
    "reset": "tsx src/cli.ts reset",
    "seed": "tsx src/cli.ts seed",
    "codegen": "kysely-codegen --env-file ../../.env.local --url \"env(MIGRATION_DATABASE_URL)\" --dialect postgres --schema saras --include-pattern \"saras.*\" --out-file src/schema.gen.ts"
  },
  "dependencies": {
    "@saras/contracts": "workspace:*",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "pg-boss": "12.35.1"
  },
  "devDependencies": {
    "@saras/testing": "workspace:*",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.17.0",
    "tsx": "^4.19.2"
  }
}
