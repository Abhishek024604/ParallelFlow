# Copy to .env.local. Variables from doc 11 §11.7. Local values match docker-compose.yml.

# Postgres (ADR-030). Neon: create the project on Postgres 16 and copy the URLs from the console.
# Owner role, DIRECT endpoint (no "-pooler"): migrations, codegen. Never used by the running app.
MIGRATION_DATABASE_URL=postgres://saras:saras@localhost:5432/saras
# App login role (member of saras_app, no BYPASSRLS). `pnpm db:migrate` creates it from this user and
# password. On Neon use the POOLED endpoint ("-pooler" in the host) and a long random password.
DATABASE_URL=postgres://saras_api:saras-api-local@localhost:5432/saras
# Optional: owner URL (direct) of a server where integration tests may create throwaway databases.
# Unset = Testcontainers (needs Docker). Never point this at a database you care about.
TEST_DATABASE_URL=

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ARTIFACTS=saras-artifacts
S3_ACCESS_KEY_ID=saras
S3_SECRET_ACCESS_KEY=saras-minio

# Auth (WorkOS test environment)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=

# Agent runtime
RUNTIME_URL=http://localhost:4300
RUNTIME_KIND=stub
RUNTIME_JWT_KEY=

# App Tools MCP server
APP_TOOLS_URL=http://localhost:4200
TOOL_TOKEN_KEY=

# Evidence
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Email (Mailpit SMTP locally), analytics, errors, tracing
SES_SMTP_HOST=localhost
SES_SMTP_PORT=1025
POSTHOG_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
