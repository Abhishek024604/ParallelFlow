{
  "name": "@parallelflow/vscode",
  "displayName": "ParallelFlow",
  "description": "Code ParallelFlow arena tasks in VS Code with the Pi coding agent, inside a folder fence with approvals.",
  "version": "0.1.0",
  "private": true,
  "publisher": "parallelflow",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The ParallelFlow agent edits files and runs commands, so it only runs in trusted folders."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onUri",
    "onView:parallelflow.sidebar",
    "onView:parallelflow.arena",
    "workspaceContains:.parallelflow/config.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parallelflow",
          "title": "ParallelFlow",
          "icon": "media/parallelflow.svg"
        }
      ]
    },
    "views": {
      "parallelflow": [
        {
          "type": "webview",
          "id": "parallelflow.sidebar",
          "name": "Agent"
        },
        {
          "id": "parallelflow.arena",
          "name": "Arena",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "parallelflow.signIn",
        "title": "Sign in",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.signOut",
        "title": "Sign out",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.linkArena",
        "title": "Link this folder to an arena",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.unlinkArena",
        "title": "Unlink this folder",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.cloneArenaRepo",
        "title": "Clone arena repo",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.startBuilding",
        "title": "Start building",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.startTask",
        "title": "Start task",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.stopAgent",
        "title": "Stop the agent",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.restartAgent",
        "title": "Restart the agent",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.newChat",
        "title": "New chat",
        "category": "ParallelFlow",
        "icon": "$(add)"
      },
      {
        "command": "parallelflow.resumeChat",
        "title": "Continue an earlier chat",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.pushBranch",
        "title": "Push branch to ParallelFlow",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.openPr",
        "title": "Open pull request",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.refreshArchitecture",
        "title": "Refresh architecture summary",
        "category": "ParallelFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "parallelflow.reopenInContainer",
        "title": "Reopen in Dev Container",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.scaffoldDevContainer",
        "title": "Add a Dev Container config",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.switchMode",
        "title": "Switch between Coder and Architect mode",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.connectClaude",
        "title": "Connect Claude Subscription",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.disconnectClaude",
        "title": "Disconnect Claude Subscription",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.focusChat",
        "title": "Focus chat",
        "category": "ParallelFlow",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "parallelflow.openChatTab",
        "title": "Open chat in editor tab",
        "category": "ParallelFlow",
        "icon": "$(link-external)"
      },
      {
        "command": "parallelflow.addSelectionToChat",
        "title": "Add selection to chat",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.approveGate",
        "title": "Approve gate",
        "category": "ParallelFlow",
        "icon": "$(check)"
      },
      {
        "command": "parallelflow.openArchFile",
        "title": "Open architecture file",
        "category": "ParallelFlow"
      },
      {
        "command": "parallelflow.openExternal",
        "title": "Open link",
        "category": "ParallelFlow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "parallelflow.openChatTab",
          "when": "view == parallelflow.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "parallelflow.refreshArchitecture",
          "when": "view == parallelflow.arena",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "parallelflow.approveGate",
          "when": "view == parallelflow.arena && viewItem == gate.approvable",
          "group": "inline"
        },
        {
          "command": "parallelflow.approveGate",
          "when": "view == parallelflow.arena && viewItem == gate.approvable"
        }
      ],
      "editor/context": [
        {
          "command": "parallelflow.addSelectionToChat",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "parallelflow@1"
        }
      ],
      "commandPalette": [
        {
          "command": "parallelflow.approveGate",
          "when": "false"
        },
        {
          "command": "parallelflow.openArchFile",
          "when": "false"
        },
        {
          "command": "parallelflow.openExternal",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "parallelflow.focusChat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "parallelflow.addSelectionToChat",
        "key": "ctrl+shift+alt+l",
        "mac": "cmd+shift+alt+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "ParallelFlow",
      "properties": {
        "parallelflow.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "ParallelFlow web address. Model calls, sign-in and pushes go here."
        },
        "parallelflow.commandAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git status *",
            "git diff",
            "git diff *",
            "git log",
            "git log *",
            "git branch",
            "ls",
            "ls *",
            "dir",
            "dir *",
            "pwd",
            "cat *",
            "npm test",
            "pnpm test",
            "npm run lint",
            "pnpm lint",
            "tsc --noEmit",
            "npx tsc --noEmit"
          ],
          "markdownDescription": "Shell commands the agent may run without asking. An entry matches the exact command; an entry ending in ` *` also matches extra arguments, which must be paths inside the folder. Commands with `;`, `&&`, `|`, `$()`, backticks, redirects or variables always ask. Test and lint commands run project code that the agent may have edited: remove them for stricter host runs."
        },
        "parallelflow.autoApproveEdits": {
          "type": "boolean",
          "default": true,
          "description": "Apply the agent's file edits inside the folder without asking. Edits to .vscode, .devcontainer, CI workflows and .parallelflow always ask; .git is never writable."
        },
        "parallelflow.approvalTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "description": "An unanswered approval is denied after this many seconds."
        },
        "parallelflow.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js 22.19 or newer, used to run the bundled Pi agent."
        },
        "parallelflow.piPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a Pi CLI script (cli.js) to use instead of the bundled one."
        },
        "parallelflow.model": {
          "type": "string",
          "default": "",
          "description": "Model id to pin: a ParallelFlow model id, or a Claude model id such as claude-opus-5-5 when parallelflow.modelSource is claude. Empty picks the fast or strong model per request."
        },
        "parallelflow.modelSource": {
          "type": "string",
          "enum": [
            "parallelflow",
            "claude"
          ],
          "enumDescriptions": [
            "Models from ParallelFlow (the arena's model provider).",
            "Your own Claude Pro or Max subscription. Run ParallelFlow: Connect Claude Subscription first."
          ],
          "default": "parallelflow",
          "description": "Where the coding agent's model calls go. Changing it restarts the agent."
        },
        "parallelflow.mode": {
          "type": "string",
          "enum": [
            "coder",
            "architect"
          ],
          "enumDescriptions": [
            "Writes and reviews code for arena tasks. /swa (architecture) still works, with its rules joining once you use it.",
            "Architecture first: the SWA rules are in every prompt (requirements to stack, HLD, LLD and conformance reviews in arch/, with approval gates)."
          ],
          "default": "coder",
          "description": "What the agent works as. Changing it restarts the agent."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@parallelflow/pi-parallelflow": "workspace:*",
    "@parallelflow/pi-swa": "workspace:*",
    "@types/markdown-it": "14.1.2",
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "0.0.36",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "markdown-it": "14.1.0",
    "typebox": "1.3.27",
    "zod": "^3.25.76"
  }
}
